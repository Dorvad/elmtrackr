<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window theme used before Compose renders. NoActionBar prevents a
        native action bar from flashing on top of the Compose Scaffold.
        Theme.AppCompat is required because MainActivity extends
        AppCompatActivity for per-app locale support (Hebrew/English),
        and DayNight keeps the pre-Compose flash matched to dark mode.
    -->
    <style name="Theme.ElmTrackr" parent="Theme.AppCompat.DayNight.NoActionBar" />
</resources>
