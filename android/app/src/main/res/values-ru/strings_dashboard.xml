    <!-- Getting-started checklist -->
    <string name="dashboard_setup_title">С чего начать</string>
    <string name="dashboard_setup_subtitle">%1$d из %2$d — узнайте, что умеет ElmTrackr</string>
    <string name="dashboard_setup_dismiss">Скрыть список</string>
    <string name="dashboard_setup_step_done">Выполнено</string>
