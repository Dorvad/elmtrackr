<?xml version="1.0" encoding="utf-8"?>
<!--
    Aurora card background: the richer variant for the tall card and big-action
    widgets. Navy base with a stronger indigo→plum wash and an aqua bloom in
    the opposite corner.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181A38" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#8C5B4DF2"
                android:centerColor="#598B5CF6"
                android:endColor="#00000000"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:centerColor="#1416C8D6"
                android:endColor="#5C16C8D6"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
