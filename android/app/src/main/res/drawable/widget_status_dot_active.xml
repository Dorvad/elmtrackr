    <item>
        <shape android:shape="oval">
            <solid android:color="#4016C8D6" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="#16C8D6" />
        </shape>
    </item>
</layer-list>
