    <!-- Disclaimers -->
    <string name="leave_disclaimer">ElmTrackr מספק הערכות המבוססות על הגדרות מקום העבודה ועל המידע שאתה מזין. הזכאות, היתרה והתשלום בפועל עשויים להיות שונים בהתאם להסכם העבודה שלך, להסכמים קיבוציים, לנתוני התלוש ולדין החל.</string>
    <string name="leave_balance_disclaimer">היתרה המשוערת מבוססת על היתרה האחרונה שהזנת ועל ההיעדרויות שדווחו ב-ElmTrackr. היא אינה כוללת צבירה חדשה או תיקונים שנעשו מצד המעסיק לאחר אותו תאריך.</string>
    <string name="leave_preset_disclaimer">ברירת המחדל לישראל היא נקודת פתיחה מוצעת, ולא ייעוץ שכר או ייעוץ משפטי. אפשר לשנות כל חלק ממנה כדי להתאים אותה להסדר שלך.</string>

