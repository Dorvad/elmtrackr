# Copy this file to local.properties (git-ignored) and fill in your values.
# Without these keys the app builds fine but shows "Auth not configured" on the Account tab.

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
supabase.url=

# Your Supabase anon/public key
supabase.anon.key=

# Optional Sentry DSN for crash reporting. Leave blank to disable Sentry.
# sentry.dsn=https://examplePublicKey@o0.ingest.sentry.io/0

# --- One-time products (clock face packs) ---
# Off by default: every pack stays free and no Play connection is made.
# Set to true only once the products listed in ClockFacePackProducts exist and are
# active in Play Console, and only for a build installed through a Play track
# (internal testing or higher) by a licence tester — Play Billing does not answer
# a sideloaded APK, so a local debug build shows the packs as unavailable.
# paid.clock.face.packs=false

# --- Release signing (required for Play Store uploads) ---
# Must match the upload key registered in Play Console (App integrity → App signing).
# Verify with: keytool -list -v -keystore <path> -alias <alias>
# KEYSTORE_PATH=keystore/elmtrackr-release.jks
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=

# --- Supabase dashboard configuration ---
# In your Supabase project → Authentication → URL Configuration, add:
#
#   Redirect URLs:
#     elmtrackr://auth/callback
#     elmtrackr://auth/reset-password
#
# This URL is used for:
#   - Email confirmation links
#   - Password reset links
#   - Magic link sign-in (if enabled)
#   - OAuth provider callbacks (if added later)
